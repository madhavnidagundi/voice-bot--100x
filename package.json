{
  "name": "hundredx-voice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "profile:check": "node scripts/check-profile.mjs",
    "security:check": "node --env-file-if-exists=.env.local scripts/check-secrets.mjs",
    "test:live": "node --env-file=.env.local scripts/live-smoke.mjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
